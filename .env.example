# LLM（必填，DeepSeek 或兼容 OpenAI 协议的端点）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

# Tavily 搜索（必填）
TAVILY_API_KEY=

# Sim4Life RAG 服务（必填，http 地址）
RAG_BASE_URL=http://127.0.0.1:8000

# Sim4Life 安装路径（必填，headless 执行用）
S4L_HOME=D:/Sim4life/sim4lifeprogram/Sim4LifeLight_7.0.0.7995
S4L_PYTHON=D:/Sim4life/sim4lifeprogram/Sim4LifeLight_7.0.0.7995/Python/python.exe

# TMS optimizer 项目路径（必填，tms_optimize 工具用）
TMS_PROJECT_DIR=D:/myvibeproject/StreamFunctionTMS
TMS_PYTHON=D:/myvibeproject/StreamFunctionTMS/.venv/Scripts/python.exe

# 产物目录（可选，默认 ./artifacts）
ARTIFACTS_DIR=artifacts
